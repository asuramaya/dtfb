# LOTSTRETCHER configuration
# Copy this to .env and fill in your values.
# Values here can be overridden by a JSON config file (see lotstretcher-config.json.example)
# or by environment variables with the LOTSTRETCHER_ prefix.

# Dealer-specific post boilerplate
LOTSTRETCHER_DEALER_NAME="Tomball Ford"
LOTSTRETCHER_DEALER_GREETING="Ask for Hector Chavez!"
LOTSTRETCHER_DEALER_ADDRESS="22702 TX-249, Tomball, TX 77375"

# Inventory URL (for daily sync)
# LOTSTRETCHER_INVENTORY_URL="https://www.yourdealer.com/inventory/all-vehicles/"

# Recraft API key (optional, for AI-generated backgrounds)
# RECRAFT_API_KEY=your_key_here
