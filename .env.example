# DTFB configuration
# Copy this to .env and fill in your values.
# Values here can be overridden by a JSON config file (see dtfb-config.json.example)
# or by environment variables with the DTFB_ prefix.

# Dealer-specific post boilerplate
DTFB_DEALER_NAME="Tomball Ford"
DTFB_DEALER_GREETING="Ask for Hector Chavez!"
DTFB_DEALER_ADDRESS="22702 TX-249, Tomball, TX 77375"

# Inventory URL (for daily sync)
# DTFB_INVENTORY_URL="https://www.yourdealer.com/inventory/all-vehicles/"

# Recraft API key (optional, for AI-generated backgrounds)
# RECRAFT_API_KEY=your_key_here
